{
  "name": "rent-a-car-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "prisma:generate": "pnpm --filter @rent-a-car/api prisma:generate",
    "prisma:migrate": "pnpm --filter @rent-a-car/api prisma:migrate",
    "prisma:studio": "pnpm --filter @rent-a-car/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3"
  },
  "engines": {
    "node": ">=18"
  }
}