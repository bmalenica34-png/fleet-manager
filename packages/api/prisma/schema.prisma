generator client {
  provider      = "prisma-client-js"
  // "native" za lokalni dev (Windows), "rhel-openssl-3.0.x" za Vercel-ov
  // serverless runtime - build kontejner koji pokreće `prisma generate`
  // nije nužno isti kao runtime kontejner koji izvršava funkciju.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Vehicle
// ---------------------------------------------------------------------------

model Vehicle {
  id                 String   @id @default(cuid())
  make               String
  model              String
  year               Int?
  licensePlate       String   @unique
  vin                String?  @unique
  registrationDocKey String? // prometna (S3 key na Hetzneru, ne raw URL)
  insurancePolicyKey String? // polica osiguranja (S3 key)

  // Datum isteka registracije (godišnji tehnički pregled). Podsjetnici idu
  // klijentu koji trenutno iznajmljuje vozilo i vlasniku 7/3/0 dana prije.
  registrationExpiresAt DateTime?

  // Dedupe per-milestone da dnevni cron ne pošalje isti podsjetnik dvaput.
  registrationReminder7SentAt DateTime?
  registrationReminder3SentAt DateTime?
  registrationReminder0SentAt DateTime?

  // Postavlja SAMO CSV bulk import (server/vehicles.ts#importVehiclesFromCsvRows)
  // kad red ima prazno/neispravno polje ali se svejedno kreira - ručni unos
  // (forma) uvijek ostavlja ovo na default false/[], jer HTML/Zod validacija
  // ondje već sprječava nepotpun submit. incompleteReasons su gotovi
  // hrvatski tekstovi za prikaz (ne field-key identifikatori) - jedino mjesto
  // koje ih čita je UI badge/tooltip, nema druge programske logike nad njima.
  hasIncompleteData Boolean  @default(false)
  incompleteReasons String[] @default([])
  // Dedupe za "nepotpuni podaci" notifikaciju (isti obrazac kao
  // registrationReminder*SentAt) - šalje se najviše jednom po vozilu, čak i
  // ako se reasons kasnije promijene.
  incompleteDataNotifiedAt DateTime?

  // Ručni toggle ("na servisu") - vlasnik ga postavlja/miče izravno, NIJE
  // izveden iz ugovora. Kad je true, nadjačava computed "pod ugovorom"/
  // "slobodno" status posvuda u UI-u (vidi toVehicleDTO u server/vehicles.ts).
  underService Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         VehicleImage[]
  contracts      Contract[]
  serviceRecords ServiceRecord[]
  vehicleCosts   VehicleCost[]

  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  key       String
  createdAt DateTime @default(now())

  @@map("vehicle_images")
}

// ---------------------------------------------------------------------------
// ServiceRecord (servisna knjižica)
// ---------------------------------------------------------------------------

// Jedna intervencija u servisnoj knjižici vozila. `provider` je namjerno
// slobodan tekst (ne relacija/enum) - strukturiranje radi buduće AI
// kategorizacije računa je poseban budući zadatak, ne dio ovog opsega.
// `cost` je uvijek u EUR (isti valutni pretpostavka kao Contract.pricePerDay/
// excessAmount - app nema multi-currency podršku nigdje).
model ServiceRecord {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  description String   // koristi se kao "Razlog" u UI-u - polje je već postojalo, nije dupliciran novi
  // LEGACY - jedinstveno "trošak" polje prije parts/labor splita. Nikad se
  // više ne piše za nove zapise (uvijek null na njima), ALI se zadržava na
  // starim zapisima radi povijesti - serviceRecordTotal() u server/
  // serviceRecords.ts računa total kao partsCost+laborCost kad su ta dva
  // polja postavljena, INAČE fallback na ovo polje (stari zapis).
  cost        Float?
  partsCost   Float?
  laborCost   Float?
  // Dobavljač DIJELOVA (npr. auto-dijelovi trgovina) - odvojeno od `provider`
  // (servis/mehaničar koji je odradio rad). Oba imaju autocomplete "memoriju"
  // prijašnjih unosa u UI-u (vidi getServiceRecordSuggestions u server/
  // serviceRecords.ts) - fleet-wide, ne po vozilu, jer isti dobavljač/servis
  // se tipično koristi za više vozila u floti.
  partsSupplier String?
  provider    String?
  receiptKey  String? // račun/dokument (S3 key na Hetzneru, ne raw URL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@map("service_records")
}

// ---------------------------------------------------------------------------
// VehicleCost (dodatni troškovi izvan servisne knjižice - leasing, kasko...)
// ---------------------------------------------------------------------------

// Diskretne kategorije (za razliku od ServiceRecord.provider, koji je
// namjerno slobodan tekst) - zahtjev eksplicitno nabraja 4 kategorije
// uklj. "ostalo", pa je enum korisniji za buduće filtriranje/izvještavanje
// nego slobodan tekst. `other` nosi `customType` za detalj.
enum VehicleCostType {
  leasing
  insurance
  kasko
  other
}

enum InstallmentFrequency {
  monthly
  quarterly
  yearly
}

// Jedan trošak vozila IZVAN servisne knjižice (koja prati pojedinačne
// servisne intervencije) - ili jednokratan (`date` postavljen) ili rata
// (`isInstallment=true`, `installmentFrequency`+`startDate` postavljeni,
// `endDate` null = "do daljnjega"/traje i dalje). App-level invarijanta
// (ne DB constraint - vidi "trust internal code" konvenciju svugdje u ovoj
// shemi): TOČNO jedan od (`date`) / (`installmentFrequency`+`startDate`)
// seta je postavljen, ovisno o `isInstallment`. Rate se pro-rata računaju
// za odabrano razdoblje (server/vehicleStats.ts), NE upisuju se kao
// pojedinačni redci po mjesecu - jedan red opisuje cijeli tekući ugovor
// (npr. leasing), izračun "koliko u ovom razdoblju" je uvijek izveden.
model VehicleCost {
  id         String          @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  costType   VehicleCostType
  customType String? // detalj kad je costType "other"
  amount     Float // za ratu: iznos PO UČESTALOSTI (npr. mjesečna rata), ne ukupan iznos ugovora

  isInstallment        Boolean               @default(false)
  installmentFrequency InstallmentFrequency? // postavljeno SAMO ako isInstallment
  startDate            DateTime? // postavljeno SAMO ako isInstallment
  endDate              DateTime? // null = "do daljnjega" (rata i dalje traje)

  date DateTime? // postavljeno SAMO ako NE isInstallment (jednokratan trošak)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@map("vehicle_costs")
}

// ---------------------------------------------------------------------------
// Owner
// ---------------------------------------------------------------------------

model Owner {
  id    String @id @default(cuid())
  email String @unique
  name  String?

  // Poveže se s Supabase auth accountom nakon prvog uspješnog magic-link
  // logina. Owner redovi se pre-provisioniraju ručno (po emailu) - login
  // stranica odbija emailove koji ovdje ne postoje, prije nego se uopće
  // pošalje magic link.
  userId String? @unique

  createdAt DateTime @default(now())

  createdContracts Contract[]

  @@map("owners")
}

// ---------------------------------------------------------------------------
// Employee
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  active
  deactivated
}

// Moduli koji se mogu dodijeliti/oduzeti pojedinom employeeu, neovisno jedan
// o drugom (namjerno čisto odvojeni - vidi EmployeePermission niže, korisnik
// razmišlja i o modularnom pricingu pa ovaj enum udvostručuje kao buduća
// "koji je modul uopće dostupan/licenciran" granica).
enum PermissionModule {
  contracts
  vehicles
  clients
  invoicing // R1/R2 računi - polje pripremljeno, fakturiranje još NIJE implementirano
  settings
}

// App je single-tenant (jedna rent-a-car tvrtka za cijelu bazu, vidi
// CLAUDE.md i CompanySettings komentar niže) - namjerno NEMA ownerId FK.
// "Employee pripada owneru" u zahtjevu znači "dio je istog poslovnog
// accounta", ne cross-tenant izolaciju - ta ne postoji nigdje drugdje u
// shemi (Vehicle/Client/Contract su već globalni), pa dodavanje FK-a ovdje
// bez stvarne tenant-scoping infrastrukture posvuda ne bi ništa postiglo.
model Employee {
  id        String         @id @default(cuid())
  firstName String
  lastName  String
  email     String         @unique
  status    EmployeeStatus @default(active)

  // Isti obrazac kao Owner.userId - poveže se s Supabase auth accountom
  // nakon prvog uspješnog magic-link logina. Employee redovi se
  // pre-provisioniraju kroz /employees stranicu (owner-only) - login
  // odbija emailove koji ovdje ne postoje ILI su deaktivirani, prije nego
  // se uopće pošalje magic link. Nema zasebnog "invite email" koraka -
  // identično owneru, employee sam zatraži magic link na /login kad mu
  // owner kaže da je dodan.
  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions      EmployeePermission[]
  createdContracts Contract[]

  @@map("employees")
}

// Postojanje retka = dodijeljena permisija za taj modul (nema "enabled:
// false" redaka - odsutnost je disabled). Zaseban model umjesto JSON polja
// na Employee namjerno - upit "svi employeei s pristupom modulu X" je
// direktan, i struktura se prirodno proširuje budućim per-modul
// pricing/licencing konceptom bez migracije JSON sheme.
model EmployeePermission {
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  module     PermissionModule

  createdAt DateTime @default(now())

  @@id([employeeId, module])
  @@map("employee_permissions")
}

// ---------------------------------------------------------------------------
// CompanySettings
// ---------------------------------------------------------------------------

enum ReportFrequency {
  off
  daily
  weekly
  monthly
  custom
}

// Singleton (jedan fiksni red, id uvijek "singleton") - app je single-tenant
// (jedna rent-a-car tvrtka spram cijele baze, vidi CLAUDE.md), pa nema
// potrebe za FK na Owner/tenantId. Prikazuje se u zaglavlju i potpisnom
// bloku generiranog Contract PDF-a (packages/api/src/pdf/ContractPdf.tsx).
model CompanySettings {
  id      String  @id @default("singleton")
  name    String?
  oib     String?
  address String?
  phone   String?
  email   String?
  logoKey String? // S3 key na Hetzneru, ne raw URL - vidi konvenciju za *Key polja niže

  // Rezervirano za budući kvalificirani/digitalni certifikat potpisa -
  // NIJE implementirano (potpisni blok je trenutno čisto tekstualni), ovo
  // polje samo osigurava da ga se kasnije može dodati bez izmjene sheme.
  digitalCertificateKey String?

  // Periodični izvještaji o floti (server/periodicReports.ts). Default
  // "off" - postojeći produkcijski račun ne počinje neočekivano primati
  // automatske mailove dok vlasnik sam ne uključi u /settings. Interval se
  // svugdje tretira kao "dana od zadnjeg slanja" (daily=1/weekly=7/
  // monthly=30/custom=reportCustomIntervalDays), NE kalendarski dan/tjedan/
  // mjesec - jednostavnije i dosljedno s "custom N dana" opcijom.
  reportFrequency          ReportFrequency @default(off)
  reportCustomIntervalDays Int? // koristi se SAMO kad je reportFrequency "custom"
  reportEmailEnabled       Boolean         @default(true)
  lastReportSentAt         DateTime? // dedupe - isti obrazac kao registrationReminder*SentAt

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// TermsAndConditions
// ---------------------------------------------------------------------------

// Versioned - svaka izmjena u /settings kreira NOVI red, nikad se ne
// overwrita/briše postojeći (potrebno za pravnu dokaznost starih ugovora -
// koji točno tekst je klijent stvarno vidio i prihvatio). `active` označava
// TOČNO jedan red kao trenutno važeći - to je app-level invarijanta koju
// održava createTermsVersion() (transakcija: prethodni active -> false,
// novi red -> true), namjerno bez DB-level partial unique indexa (jedino
// mjesto koje piše u ovu tablicu je ta funkcija - vidi "trust internal
// code" konvenciju, isto obrazloženje kao svugdje drugdje u ovoj shemi).
// `content` je plain text, paragrafi odvojeni praznim retkom ("\n\n") - isti
// format kao prijašnji hardkodirani TERMS_TEXT u sign/[token]/page.tsx,
// namjerno NE markdown/rich text (nema XSS rizika jer se nikad ne renderira
// kao HTML, lako se i uređuje u textarei i renderira u PDF bez parsera).
model TermsAndConditions {
  id      String  @id @default(cuid())
  version Int     @default(autoincrement())
  content String
  active  Boolean @default(false)

  createdAt DateTime @default(now())

  contracts Contract[]

  @@map("terms_and_conditions")
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

enum ClientType {
  fizicka
  pravna
}

model Client {
  id                String   @id @default(cuid())
  // Tip klijenta. `fizicka` (default) - postojeće ponašanje nepromijenjeno,
  // firstName/lastName/oib su podaci fizičke osobe. `pravna` - oib je OIB
  // TVRTKE (ne osobe), companyName/companyAddress drže podatke sjedišta
  // (auto-popunjeni preko sudskog registra, vidi server/sudreg.ts);
  // firstName/lastName su kontakt/odgovorna osoba koja potpisuje i vozi.
  type              ClientType @default(fizicka)
  firstName         String
  lastName          String
  // Za `fizicka` OIB osobe, za `pravna` OIB tvrtke (@unique vrijedi za oba).
  oib               String   @unique
  companyName       String?
  companyAddress    String?
  email             String
  phone             String
  address           String?
  // Zadržano iz signing wizarda (packages/api/src/server/signing.ts) - klijent
  // uploada jednu (prednju) stranu svakog dokumenta kao dio obaveznog
  // potpisnog flowa. NIJE preimenovano/uklonjeno da se ne dira taj kritičan,
  // već testiran put (vidi bug #30/#37 u PROGRESS.md) - umjesto toga nova
  // polja niže dodaju stražnju stranu + omogućuju owneru da upravlja
  // dokumentima izravno sa stranice klijenta. Kompletnost se računa kao
  // "postoji BILO ILI dedicated *FrontKey ILI ovo starije polje" (vidi
  // toClientDTO u server/clients.ts) - klijent koji je već prošao signing
  // ne smije lažno ispasti "nedostaje" samo zato što polje ima drugo ime.
  driverLicenseKey  String?
  idDocumentKey     String?

  // Novi slotovi - dodani da bi se moglo pratiti KOMPLETNOST identifikacijskih
  // dokumenata (osobna + vozačka, obje strane), potrebno za dokaznost tko je
  // vozio vozilo u slučaju prometnog prekršaja. Upravljaju se sa stranice
  // klijenta (owner), odvojeno od signing wizarda.
  idDocumentFrontKey     String?
  idDocumentBackKey      String?
  driverLicenseFrontKey  String?
  driverLicenseBackKey   String?

  // Tekstualna polja - popunjena ručno ili preko CSV bulk uvoza (vidi
  // importClientsFromCsvRows u server/clients.ts). Odvojeno od gornjih
  // *Key polja (skenirane slike dokumenata) - ovo su brojevi ISPISANI na
  // dokumentu, ne sami dokumenti. idNumber je @unique (isti obrazac kao
  // Vehicle.vin) - pravi duplikat "broj osobne" preko dva klijenta se time
  // hvata i na DB razini, ne samo app-level provjerom u CSV importu.
  idNumber              String?  @unique
  driverLicenseNumber   String?
  birthDate             DateTime?

  // CSV bulk uvoz klijenata - isti obrazac kao Vehicle.hasIncompleteData/
  // incompleteReasons/incompleteDataNotifiedAt (vidi migraciju
  // 20260824210000_add_vehicle_incomplete_data_tracking). Red se uvijek
  // uveze čak i s nedostajućim/lošim poljima (osim pravih duplikata OIB-a/
  // broja osobne) - ovo bilježi ŠTO nedostaje za naknadnu dopunu.
  hasIncompleteData Boolean  @default(false)
  incompleteReasons String[] @default([])
  incompleteDataNotifiedAt DateTime?

  // Poveže se s Supabase auth accountom kad se klijent registrira/potvrdi.
  // Nullable jer klijent može kompletirati cijeli signing flow bez accounta.
  userId            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contracts Contract[]

  @@map("clients")
}

// ---------------------------------------------------------------------------
// Contract
// ---------------------------------------------------------------------------

enum ContractStatus {
  draft
  sent
  signed
  expired
}

// "daily" = postojeće ponašanje (bez RentPayment generacije, isto kao prije
// ovog polja). weekly/monthly - Contract.pricePerDay tada predstavlja cijenu
// PO PERIODU (ne po danu, unatoč imenu polja - ime nije mijenjano da se ne
// dira PDF/ostatak koda koji ga koristi), i createRentPaymentsForContract
// (server/rentPayments.ts) generira RentPayment retke unaprijed.
enum PaymentFrequency {
  daily
  weekly
  monthly
}

model Contract {
  id     String @id @default(cuid())
  // Sekvencijalni broj ugovora, čitljiv za owner/klijenta (za razliku od
  // cuid `id`-a) - prikazan na PDF-u i u UI popisima kao "broj ugovora".
  number Int    @unique @default(autoincrement())

  vehicleId String
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id])
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id])
  dateFrom  DateTime
  dateTo    DateTime
  status    ContractStatus @default(draft)

  // Owner/employee account koji je izdao ugovor - za potpisni blok na PDF-u
  // ("Za {firma}: {ime izdavatelja}"). Nullable jer postojeći ugovori
  // (kreirani prije ovog polja) nemaju taj podatak i ne mogu se retroaktivno
  // popuniti. Točno JEDNO od createdByOwnerId/createdByEmployeeId je
  // postavljeno (app-level konvencija, ne DB constraint - Prisma nema
  // nativan polymorphic FK, a stvarna "User" nadklasa bi zahtijevala veći
  // refactor Owner/Employee auth sloja nego što ova promjena opravdava).
  createdByOwnerId String?
  createdByOwner   Owner?  @relation(fields: [createdByOwnerId], references: [id])

  createdByEmployeeId String?
  createdByEmployee   Employee? @relation(fields: [createdByEmployeeId], references: [id])

  // Jednokratan JWT signing token, 48h expiry, invalidira se odmah nakon potpisa.
  signingToken           String?   @unique
  signingTokenExpiresAt  DateTime?
  signedAt               DateTime?
  signatureKey           String?

  contractPdfKey String?
  protocolPdfKey String?

  // Prijevremeno zatvaranje - postavlja ih SAMO closeContractEarly()
  // (server/contracts.ts), nikad se ne mijenjaju automatski. `dateTo` OSTAJE
  // netaknut (originalno ugovoreni datum, povijesni podatak) - actualEndDate
  // bilježi kad je najam STVARNO završio. Vozilo se računa "slobodno" čim je
  // closedAt postavljen (vidi findCurrentContractForVehicle), neovisno o
  // tome koliko je dateTo još daleko u budućnosti.
  closedAt      DateTime?
  actualEndDate DateTime?

  // Podaci za redizajnirani Contract PDF (dodano naknadno, nije bilo dio
  // izvornog v1 scope-a - sva polja nullable). Owner unosi pri kreiranju
  // ugovora (poznato prije primopredaje): pickupLocation, odometerStart,
  // pricePerDay, excessAmount, paymentMethod. returnLocation/odometerEnd
  // nemaju još ulazni flow (nema "povrat vozila" značajke u v1) - postavljaju
  // se samo ručno dok ta funkcija ne postoji, PDF prikazuje "—" ako su null.
  pickupLocation String?
  returnLocation String?
  odometerStart  Int?
  odometerEnd    Int?
  pricePerDay    Float?
  excessAmount   Float?
  paymentMethod  String?
  // Učešće/depozit (participacija) - odvojeno od excessAmount ("Učešće u
  // šteti" = franšiza/osigurateljni izraz, potpuno drugo značenje). Korisnik
  // je eksplicitno tražio "učešće (depozit/participacija)" kao NOVO polje -
  // provjereno da excessAmount nije to isto prije dodavanja.
  depositAmount Float?

  // Učestalost naplate - "daily" ne mijenja ništa postojeće (nema RentPayment
  // redaka). weekly/monthly generiraju RentPayment raspored unaprijed pri
  // kreiranju ugovora (vidi createRentPaymentsForContract, server/
  // rentPayments.ts) - pricePerDay tada predstavlja cijenu PO PERIODU.
  paymentFrequency PaymentFrequency @default(daily)
  rentPayments     RentPayment[]

  // Prihvaćanje uvjeta najma (scroll-to-accept korak u signing wizardu,
  // prije potpisa). termsAcceptedAt postavlja SERVER u trenutku obrade
  // potpisanog submita (ne klijentski timestamp - pouzdaniji zapis "kad je
  // stvarno primljeno"). termsVersion (string) je zadržan zbog postojećeg
  // PDF prikaza ("verzija X") - za nove ugovore se sad izvodi iz
  // termsVersionId (String(TermsAndConditions.version)), ne više iz
  // klijentskog inputa. termsVersionId referencira TOČNU verziju koju je
  // klijent vidio (server resolvea po id-u koji je vratio GET /api/sign/
  // [token] - nikad ne vjeruje slobodnom klijentskom stringu). termsPdfKey
  // je snapshot te verzije kao PDF, generiran i spremljen uz ostale
  // ugovorne dokumente (vidi finalizeContractDocuments).
  termsAcceptedAt DateTime?
  termsVersion    String?
  termsVersionId  String?
  termsAndConditions TermsAndConditions? @relation(fields: [termsVersionId], references: [id])
  termsPdfKey     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handoverPhotos HandoverPhoto[]
  annexes        Annex[]
  photoRequests  PhotoRequest[]

  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@map("contracts")
}

// ---------------------------------------------------------------------------
// RentPayment (praćenje plaćanja najma - tjedne/mjesečne rate)
// ---------------------------------------------------------------------------

// Jedan period naplate za weekly/monthly ugovor (vidi Contract.paymentFrequency).
// Generira ih createRentPaymentsForContract pri kreiranju ugovora, i
// extendRentPaymentsForContract pri produženju (Annex) - server/
// rentPayments.ts. Ne postoje redci za "daily" ugovore.
model RentPayment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  amount      Float
  // Datum dospijeća - jednak periodStart (naplata na početku perioda, isti
  // obrazac kao tjedni/mjesečni najam gotovinski plaćajućih klijenata,
  // npr. taxi). Zasebno polje (ne izvedeno iz periodStart) da bude jasno
  // razdvojeno značenje i da bude prilagodljivo za buduće ručne izmjene.
  dueDate     DateTime

  paid   Boolean   @default(false)
  paidAt DateTime?

  // Dedupe polja - isti obrazac kao *SentAt/*NotifiedAt svugdje drugdje u
  // ovoj shemi (registrationReminder*SentAt, incompleteDataNotifiedAt) -
  // svaka notifikacija ide najviše jednom po retku.
  ownerDueNotifiedAt      DateTime?
  clientOverdueNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([dueDate])
  @@map("rent_payments")
}

// ---------------------------------------------------------------------------
// HandoverPhoto
// ---------------------------------------------------------------------------

enum PhotoAngle {
  front
  back
  left
  right
  interior_dashboard
  interior_seats
  odometer
  other
}

// Koji je konkretan dio vozila oštećen - odvojeno od PhotoAngle (koji kut
// je slika snimljena) jer oštećenje nije nužno vezano na jedan od 4
// standardna kuta primopredaje. Strukturirano polje (ne slobodni tekst)
// da bi se kasnije moglo filtrirati/pretraživati po dijelu vozila.
enum VehiclePart {
  front_bumper
  rear_bumper
  hood
  trunk
  roof
  windshield
  rear_window
  left_front_door
  left_rear_door
  right_front_door
  right_rear_door
  left_front_fender
  right_front_fender
  left_rear_fender
  right_rear_fender
  left_mirror
  right_mirror
  left_front_wheel
  right_front_wheel
  left_rear_wheel
  right_rear_wheel
  headlight_left
  headlight_right
  taillight_left
  taillight_right
  interior
  other
}

model HandoverPhoto {
  id       String @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Ako je slika nastala kao odgovor na periodični zahtjev za slikanje
  // tijekom aktivnog najma, a ne kod primopredaje.
  photoRequestId String?
  photoRequest   PhotoRequest? @relation(fields: [photoRequestId], references: [id])

  angle             PhotoAngle
  key               String
  damageDescription String?

  // Postavljeno samo za dodatne fotografije prijavljenog oštećenja (angle
  // je tada "other") - koji dio vozila je oštećen, strukturirano polje.
  // Null za standardne 4 slike primopredaje po kutovima.
  damagedPart VehiclePart?

  createdAt DateTime @default(now())

  @@index([contractId])
  @@index([photoRequestId])
  @@map("handover_photos")
}

// ---------------------------------------------------------------------------
// Annex (produženje ugovora)
// ---------------------------------------------------------------------------

enum AnnexStatus {
  draft
  sent
  signed
  expired
}

model Annex {
  id               String      @id @default(cuid())
  parentContractId String
  parentContract   Contract    @relation(fields: [parentContractId], references: [id])
  newDateTo        DateTime
  status           AnnexStatus @default(draft)

  signingToken          String?   @unique
  signingTokenExpiresAt DateTime?
  signedAt              DateTime?

  annexPdfKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentContractId])
  @@map("annexes")
}

// ---------------------------------------------------------------------------
// PhotoRequest (periodično slikanje tijekom najma)
// ---------------------------------------------------------------------------

model PhotoRequest {
  id          String    @id @default(cuid())
  contractId  String
  contract    Contract  @relation(fields: [contractId], references: [id])
  requestedAt DateTime  @default(now())
  fulfilledAt DateTime?

  // Jednokratan JWT token (48h), isti mehanizam kao Contract/Annex signing.
  requestToken          String?   @unique
  requestTokenExpiresAt DateTime?

  photos HandoverPhoto[]

  @@index([contractId])
  @@map("photo_requests")
}
