# --- Database (Supabase Postgres) ---
# Pooled connection (za app runtime)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direktna konekcija (za prisma migrate)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Hetzner Object Storage (S3-compatible) ---
HETZNER_S3_ENDPOINT="https://<region>.your-objectstorage.com"
HETZNER_S3_REGION="eu-central"
HETZNER_S3_BUCKET=""
HETZNER_S3_ACCESS_KEY_ID=""
HETZNER_S3_SECRET_ACCESS_KEY=""

# --- Resend (email) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# --- Owner (prima kopiju potpisanog ugovora + zapisnika) ---
OWNER_EMAIL="owner@yourdomain.com"

# --- Company info za zaglavlje Contract PDF-a (opcionalno - ako nedostaju,
# PDF prikazuje prazno/"—" umjesto da sruši signing flow) ---
COMPANY_NAME="NAVALIS-CISSA"
COMPANY_ADDRESS=""
COMPANY_OIB=""
COMPANY_PHONE=""
COMPANY_EMAIL=""

# --- Signing token ---
SIGNING_TOKEN_SECRET=""

# --- Cron ---
CRON_SECRET=""

# --- App URLs ---
NEXT_PUBLIC_OWNER_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLIENT_SIGNING_BASE_URL="http://localhost:3000/sign"

# --- Mobile (Expo) ---
MOBILE_APP_SCHEME="rentacarmanager://"
